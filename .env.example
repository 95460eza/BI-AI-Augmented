# MAKE A "COPY" OF "THIS" FILE "INSIDE" THE "SAME" FOLDER AS THIS ONE (THE REPO "ROOT") AND "NAME" IT ".ENV". THEN "FILL" THE "COPY" IN WITH THE "REAL" SECRETS "VALUES". # MAKE SURE TO ALSO KEEP THIS ".ENV.EXAMPLE" FILE AS-IS. 
# ".env" MUST ALSO BE PART OF ".gitignore". "NEVER" COMMIT "REAL" SECRETS!!!!!!!

# ---------------------------------------------------------------------------
# MCP 1 — YugabyteDB (Northwind baseline)
# YSQL is Postgres-wire-compatible; default YSQL port is 5433.
# Leave YB_HOST empty to let the MCP server fall back to bundled sample data.
# ---------------------------------------------------------------------------
YB_HOST=
YB_PORT=5433
YB_DATABASE=yugabyte
YB_USER=yugabyte
YB_PASSWORD=
YB_SCHEMA=public

# SSL. `require` encrypts but does NOT verify the server certificate.
# For managed clusters (e.g. YugabyteDB Aeon), prefer verified TLS:
#   YB_SSLMODE=verify-full  and  YB_SSLROOTCERT=/abs/path/to/root.crt
# Leave YB_SSLROOTCERT empty for sslmode require/prefer/disable (no CA needed).
YB_SSLMODE=prefer
YB_SSLROOTCERT=

# Where the running app reaches the YugabyteDB MCP server (started separately).
MCP_YUGABYTE_URL=http://127.0.0.1:8000/mcp

# Host/port the MCP server itself binds to.
MCP_YUGABYTE_HOST=127.0.0.1
MCP_YUGABYTE_PORT=8000

# ---------------------------------------------------------------------------
# MCP 3 — Python/ML forecasting server
# ---------------------------------------------------------------------------
MCP_ML_URL=http://127.0.0.1:8001/mcp
MCP_ML_HOST=127.0.0.1
MCP_ML_PORT=8001

# ---------------------------------------------------------------------------
# LLM — Agents 3 (Suggestion) & 6 (Insight)
# Provider-swap seam: set LLM_PROVIDER=ollama (+ LOCAL_MODEL) for a local model.
# If ANTHROPIC_API_KEY is empty, the app runs with deterministic mock proposals.
# ---------------------------------------------------------------------------
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8

# Local LLM (only used when LLM_PROVIDER=ollama)
LOCAL_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Langfuse observability (optional — app runs without it, just untraced)
# Get keys from your Langfuse project settings.
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
